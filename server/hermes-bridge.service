[Unit]
Description=Hermes Mobile bridge (fronts real Hermes for the Flutter app)
# Start after the network and the Hermes gateway are up. NOTE: deliberately
# NOT PartOf= the gateway — the bridge is independent, and tying it to the
# gateway means a gateway restart would tear down in-flight chats.
Wants=network.target hermes-gateway.service
After=network.target hermes-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/hermes/repos/hermes-mobile/server
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=BRIDGE_TOKEN=REPLACE_WITH_TOKEN
ExecStart=/home/hermes/.hermes/hermes-agent/venv/bin/python3 /home/hermes/repos/hermes-mobile/server/bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
